#!/bin/sh -e

create_hosts_file() {
  if [ -e /etc/hosts ]; then return 0; fi

  cat > /etc/hosts <<-EOF
	127.0.0.1	localhost
	::1		localhost ip6-localhost ip6-loopback
	ff02::1		ip6-allnodes
	ff02::2		ip6-allrouters

EOF
}

create_networks_file() {
  if [ -e /etc/networks ]; then return 0; fi

  cat > /etc/networks <<-EOF
	default		0.0.0.0
	loopback	127.0.0.0
	link-local	169.254.0.0

EOF
}

case "$1" in
    configure)
    if [ -z "$2" ]; then
	create_hosts_file
	create_networks_file
    fi
    ;;
esac



#!/bin/sh -e

delete_if_md5_matches() {
  local md5

  if [ -e /etc/hosts ]; then
  md5="$(md5sum /etc/hosts | sed -e 's/ .*//')"
  case "$md5" in
    05e70b0d3ac00a2fbc94781871ae9aa8) rm /etc/hosts ;;
  esac
  fi

  if [ -e /etc/networks ]; then
  md5="$(md5sum /etc/networks | sed -e 's/ .*//')"
  case "$md5" in
    d013c6de91b961753d4ba901347aa6c8) rm /etc/networks ;;
  esac
  fi
}

case "$1" in
    purge)
    delete_if_md5_matches
    ;;
esac


